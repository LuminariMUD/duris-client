# .env.example - This file is a template for the environment variables required to run the application. Copy this file to .env and fill in the appropriate values.

# If relevant, local location of the code for the MUD server and MUD website (which also has a MUD client built into it)
MUD_SERVER_PATH=/path/to/mud-server
MUD_WEBSITE_PATH=/path/to/mud-website

# In-game staff test account.
GAME_ACCOUNT_NAME=
GAME_ACCOUNT_PASSWORD=
GAME_ACCOUNT_CHARACTER_NAME=
